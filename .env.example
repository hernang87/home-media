# Copy to .env and fill in.
# Folder with your movies and shows (default: ~/Bajadas, then ~/Documents/Bajadas)
# MEDIA_DIR=/Users/you/Documents/Bajadas

# Free key from https://www.themoviedb.org/settings/api (either the v3 key or the v4 read token)
TMDB_API_KEY=
# Metadata language, e.g. en-US or es-AR
TMDB_LANGUAGE=en-US

# PORT=8200
# SERVER_NAME=Home Media
